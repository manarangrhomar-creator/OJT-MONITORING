# ============================================
# OJT Monitoring - Production Environment
# ============================================
# Copy this to /opt/ojt-monitoring/.env on your Oracle Cloud VM
# and fill in the values.

# --- Django ---
SECRET_KEY=change-me-to-a-random-secret-key-run-this
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False
ALLOWED_HOSTS=YOUR_ORACLE_VM_IP

# --- Database (Oracle Cloud PostgreSQL) ---
DATABASE_URL=postgres://ojt_user:CHANGE_ME_PASSWORD@localhost:5432/ojt_monitoring

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Email (optional - for password reset OTPs) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=OJT Monitoring <your-email@gmail.com>
